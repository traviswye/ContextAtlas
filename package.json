{
  "name": "contextatlas",
  "version": "0.7.3",
  "description": "An MCP server that gives Claude Code a curated atlas of your codebase — fusing LSP precision with architectural intent from your ADRs, docs, and git history.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude-code",
    "lsp",
    "language-server-protocol",
    "codebase-context",
    "code-atlas",
    "code-intelligence",
    "atlas",
    "adr",
    "architectural-decision-records",
    "typescript",
    "python",
    "go",
    "ruby",
    "rails"
  ],
  "author": "Travis Wye",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/traviswye/ContextAtlas.git"
  },
  "bugs": {
    "url": "https://github.com/traviswye/ContextAtlas/issues"
  },
  "homepage": "https://github.com/traviswye/ContextAtlas#readme",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "contextatlas": "./dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/generate-prompt-artifacts.mjs",
    "dev": "tsc --watch",
    "start": "node ./dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@modelcontextprotocol/sdk": "^0.5.0",
    "better-sqlite3": "^11.3.0",
    "glob": "^11.0.0",
    "js-yaml": "^4.1.0"
  },
  "peerDependencies": {
    "pyright": "^1.1.409",
    "typescript-language-server": "^4.3.0"
  },
  "peerDependenciesMeta": {
    "pyright": {
      "optional": false
    },
    "typescript-language-server": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "pyright": "^1.1.409",
    "typescript": "^5.6.0",
    "typescript-language-server": "^4.3.0",
    "vitest": "^2.1.0"
  }
}
