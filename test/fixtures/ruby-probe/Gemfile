# Minimal Rails 8.0 probe fixture per v0.9 Stream A Substep 2.
# Authored for scripts/ruby-lsp-probe.ts to exercise ruby-lsp +
# ruby-lsp-rails capabilities; not a runnable application.
#
# Run `bundle install` once before running the probe so
# `bundle exec ruby-lsp` resolves correctly.

source 'https://rubygems.org'

ruby '~> 3.3'

gem 'rails', '~> 8.0.0'

# External acts_as_* DSL macro probe target. Chosen for canonical
# class-level external-DSL shape; soft-delete is the most-installed
# acts_as_* gem on production Rails codebases. Probe captures
# ruby-lsp-rails behavior on external DSL vs core Rails DSL.
gem 'paranoia', '~> 2.6'

# Version pinning per Option D adjudication (cycle-observation 24
# third surface): ship on stable-compatible pair, NOT pre-release.
#
# ruby-lsp's stable max is 0.26.9 (May 2026), but ruby-lsp-rails 0.4.8
# pins ruby-lsp `>= 0.24.0, < 0.25.0` — the add-on lags 2+ minor
# versions behind main. ruby-lsp 0.27+ (Rubydex-backed indexer) and
# ruby-lsp-rails 0.5.0+ exist only as pre-release at this date.
#
# Stable-compatible pair: ruby-lsp 0.24.2 + ruby-lsp-rails 0.4.8.
# v1.1-candidates entry: upgrade to 0.27+/0.5+ pair once both have
# stable releases.
group :development do
  gem 'ruby-lsp', '~> 0.24.2', require: false
  gem 'ruby-lsp-rails', '~> 0.4.8', require: false
end
