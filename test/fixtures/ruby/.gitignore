# Bundler artifacts produced by `bundle install`. Manifest (Gemfile)
# is committed; lockfile + local gem cache are not, mirroring the Go
# fixture pattern (go.mod committed, go.sum + vendor/ not).
Gemfile.lock
.bundle/
vendor/bundle/

# Rails runtime artifacts generated by ruby-lsp-rails add-on boot
# attempts. tmp/local_secret.txt and similar transient state created
# at `Rails.application.initialize!` time; not committable.
tmp/
log/
